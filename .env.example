# ===========================================================================
#  LLM provider  --  pick any ONE (or none, and the heuristic fallback runs)
# ===========================================================================
#
#  The app auto-detects which provider to use based on which key is set below.
#  Priority: Gemini > Anthropic > heuristic.
#
#  You can force a specific provider by uncommenting LLM_PROVIDER below.

# ---- Option A: Google Gemini  (recommended - free, no credit card) --------
# Get a key at https://aistudio.google.com/app/apikey
# Free tier: 15 req/min, 1,000 req/day on Gemini 1.5/2.5 Flash.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ---- Option B: Anthropic Claude  (paid, best quality) ---------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# ---- Force a specific provider (optional) ---------------------------------
# Values: gemini | anthropic | heuristic
# LLM_PROVIDER=gemini

# ===========================================================================
#  Database  (defaults to a local SQLite file under data/)
# ===========================================================================
# DATABASE_URL=sqlite:///./data/flashcards.db

# ===========================================================================
#  Generation tuning
# ===========================================================================
# Max number of cards to request from the LLM per chunk.
MAX_CARDS_PER_CHUNK=8
# Target character length of each chunk sent to the LLM.
CHUNK_TARGET_CHARS=3000
# Hard cap on total cards per uploaded PDF.
MAX_TOTAL_CARDS=50
# Maximum PDF pages to process (pages beyond this are skipped).
MAX_PDF_PAGES=50
# Maximum PDF file size in MB.
MAX_PDF_SIZE_MB=10

# ===========================================================================
#  Auth / Sessions
# ===========================================================================
# REQUIRED. The session cookie is a signed token, so anyone who knows this
# value can mint a valid session for ANY account -- no password needed.
# It must be long and random. Generate one with:
#
#     python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
#
# Placeholder values and anything under 32 characters are refused: the app
# substitutes a random key and logs a CRITICAL warning, which keeps sessions
# unforgeable but logs everyone out on every restart until you set a real one.
SECRET_KEY=

# Send the session cookie only over HTTPS.
#   auto  (default) follow the request scheme; keeps http://localhost working
#   true  always set Secure -- correct for any real deployment
#   false never set Secure
# SESSION_COOKIE_SECURE=auto

# Emit Strict-Transport-Security. auto = only on HTTPS requests.
# ENABLE_HSTS=auto

# Failed login/signup attempts allowed per client IP per window.
# AUTH_RATE_LIMIT_ATTEMPTS=10
# AUTH_RATE_LIMIT_WINDOW=300

# Minimum password length at signup.
# MIN_PASSWORD_LENGTH=8
