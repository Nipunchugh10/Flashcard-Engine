# ===========================================================================
#  LLM provider  --  pick any ONE (or none, and the heuristic fallback runs)
# ===========================================================================
#
#  The app auto-detects which provider to use based on which key is set below.
#  Priority: Groq > Gemini > Anthropic > heuristic.
#
#  You can force a specific provider by uncommenting LLM_PROVIDER below.

# ---- Option A: Groq  (recommended - free, no credit card) -----------------
# Get a key in 2 minutes at https://console.groq.com
# Free tier: 30 req/min, 14,400 req/day, Llama 3.3 70B.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Option B: Google Gemini  (also free, no credit card) -----------------
# Get a key at https://aistudio.google.com/app/apikey
# Free tier: 15 req/min, 1,000 req/day on Gemini 2.5 Flash-Lite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Option C: Anthropic Claude  (paid, best quality) ---------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ---- Force a specific provider (optional) ---------------------------------
# Values: groq | gemini | anthropic | heuristic
# LLM_PROVIDER=groq

# ===========================================================================
#  Database  (defaults to a local SQLite file under data/)
# ===========================================================================
# DATABASE_URL=sqlite:///./data/flashcards.db

# ===========================================================================
#  Generation tuning
# ===========================================================================
# Max number of cards to request from the LLM per chunk.
MAX_CARDS_PER_CHUNK=8
# Target character length of each chunk sent to the LLM.
CHUNK_TARGET_CHARS=3500
# Hard cap on total cards per uploaded PDF.
MAX_TOTAL_CARDS=80

# ===========================================================================
#  Auth / Sessions
# ===========================================================================
SECRET_KEY=change-me-to-something-random
